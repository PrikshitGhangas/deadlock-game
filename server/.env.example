# Optional LLM tutor. Copy this file to server/.env and fill in ONE provider.
# The offline tutor works without any of this.

# --- Google Gemini (free tier, no card): https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# AI_API_KEY=your_gemini_api_key_here
# AI_MODEL=gemini-2.5-flash

# --- Groq (free tier): https://console.groq.com/keys
# AI_PROVIDER=groq
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (free models end with ":free"): https://openrouter.ai/keys
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-...
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Any OpenAI-compatible server, e.g. local Ollama (no key needed)
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
